@{
    ViewData["Title"] = "Agente IA";
}

<div class="row justify-content-center h-100">
    <div class="col-md-8 d-flex flex-column" style="height: 80vh;">
        <div class="card shadow border-0 flex-grow-1 d-flex flex-column overflow-hidden">
            <!-- Chat Header -->
            <div class="card-header d-flex align-items-center p-3 border-0">
                <div class="rounded-circle bg-dark p-2 me-3 border border-primary">
                    <i class="bi bi-robot text-primary fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-0 text-light fw-bold">Asistente CineDB</h5>
                    <small class="text-muted">En línea | Consultas en tiempo real</small>
                </div>
            </div>

            <!-- Chat Messages Container -->
            <div id="chatWindow" class="card-body overflow-auto p-4 flex-grow-1 bg-dark" style="scroll-behavior: smooth;">
                <!-- Welcome Message -->
                <div class="chat-bubble agent-bubble mb-3 animate-fade-in">
                    <div class="bubble-content p-3 shadow border-start border-4 border-primary">
                        <p class="mb-0 text-light">¡Hola! Soy tu asistente de CineDB. Puedo ayudarte a consultar tus registros, ver estadísticas de latencia o encontrar películas similares. ¿En qué puedo ayudarte hoy?</p>
                    </div>
                </div>
            </div>

            <!-- Suggested Questions -->
            <div class="p-3 bg-dark border-top border-secondary overflow-auto d-flex gap-2 no-scrollbar" style="white-space: nowrap;">
                <button class="btn btn-outline-light btn-sm rounded-pill suggestion-btn">¿Cuántos registros tengo?</button>
                <button class="btn btn-outline-light btn-sm rounded-pill suggestion-btn">¿Cuáles son mis últimas películas?</button>
                <button class="btn btn-outline-light btn-sm rounded-pill suggestion-btn">¿Qué errores hubo?</button>
                <button class="btn btn-outline-light btn-sm rounded-pill suggestion-btn">¿Cuál es la latencia promedio?</button>
            </div>

            <!-- Chat Input -->
            <div class="card-footer bg-dark p-3 border-top border-secondary">
                <form id="chatForm" class="input-group">
                    <input type="text" id="userInput" class="form-control rounded-pill-start border-secondary bg-grey px-4 text-light" placeholder="Escribe tu pregunta aquí..." autocomplete="off">
                    <button class="btn btn-primary rounded-pill-end px-4" type="submit">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-grey { background-color: var(--gx-grey) !important; }
    .chat-bubble { max-width: 85%; }
    .user-bubble { align-self: flex-end; margin-left: auto; }
    .agent-bubble { align-self: flex-start; }
    
    .user-bubble .bubble-content {
        background-color: var(--gx-red);
        color: white;
        border-radius: 1.2rem 1.2rem 0 1.2rem;
        box-shadow: 0 4px 15px rgba(250, 30, 78, 0.3);
    }
    
    .agent-bubble .bubble-content {
        background-color: var(--gx-grey);
        border-radius: 1.2rem 1.2rem 1.2rem 0;
        border: 1px solid var(--gx-border);
    }

    .animate-fade-in { animation: fadeIn 0.3s ease-in; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .typing-indicator span {
        height: 8px; width: 8px; background: var(--gx-red); display: inline-block;
        border-radius: 50%; animation: bounce 1.3s infinite; opacity: 0.4;
    }
    .typing-indicator span:nth-child(2) { animation-delay: 0.15s; }
    .typing-indicator span:nth-child(3) { animation-delay: 0.3s; }
    @@keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-4px); } }
</style>

@section Scripts {
    <script>
        const chatWindow = document.getElementById('chatWindow');
        const chatForm = document.getElementById('chatForm');
        const userInput = document.getElementById('userInput');

        function appendMessage(text, isUser = false, data = null) {
            const container = document.createElement('div');
            container.className = `chat-bubble ${isUser ? 'user-bubble' : 'agent-bubble'} mb-3 animate-fade-in`;
            
            let html = `
                <div class="bubble-content p-3 shadow ${isUser ? '' : 'border-start border-4 border-primary'}">
                    <p class="mb-0 ${isUser ? 'text-white' : 'text-light'}">${text}</p>
            `;

            if (data) {
                html += renderData(data);
            }

            html += `</div>`;
            container.innerHTML = html;
            chatWindow.appendChild(container);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        function renderData(data) {
            if (!Array.isArray(data) || data.length === 0) return '';
            
            let table = `<div class="table-responsive mt-3"><table class="table table-sm table-bordered border-secondary small mb-0 text-light"><thead><tr class="text-primary">`;
            
            // Header
            const keys = Object.keys(data[0]);
            keys.forEach(key => table += `<th class="text-uppercase">${key}</th>`);
            table += `</tr></thead><tbody>`;
            
            // Rows
            data.forEach(row => {
                table += `<tr>`;
                keys.forEach(key => table += `<td>${row[key] ?? '-'}</td>`);
                table += `</tr>`;
            });
            
            table += `</tbody></table></div>`;
            return table;
        }

        function showTypingIndicator() {
            const div = document.createElement('div');
            div.id = 'typingIndicator';
            div.className = 'chat-bubble agent-bubble mb-3 animate-fade-in';
            div.innerHTML = `
                <div class="bubble-content p-3 shadow border-start border-4 border-primary">
                    <div class="typing-indicator"><span></span> <span></span> <span></span></div>
                </div>
            `;
            chatWindow.appendChild(div);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            if (indicator) indicator.remove();
        }

        chatForm.onsubmit = async (e) => {
            e.preventDefault();
            const question = userInput.value.trim();
            if (!question) return;

            userInput.value = '';
            appendMessage(question, true);
            showTypingIndicator();

            try {
                const response = await fetch('/api/agent/query', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question })
                });

                const result = await response.json();
                removeTypingIndicator();
                appendMessage(result.answer, false, result.data);
            } catch (error) {
                removeTypingIndicator();
                appendMessage("Lo siento, hubo un error al procesar tu consulta.", false);
            }
        };

        // Handle suggested questions
        document.querySelectorAll('.suggestion-btn').forEach(btn => {
            btn.onclick = () => {
                userInput.value = btn.innerText;
                chatForm.dispatchEvent(new Event('submit'));
            };
        });
    </script>
}
