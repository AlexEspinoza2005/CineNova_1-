@{
    ViewData["Title"] = "Agente IA";
}

<div class="row justify-content-center h-100">
    <div class="col-md-8 d-flex flex-column" style="height: 80vh;">
        <div class="card shadow border-0 flex-grow-1 d-flex flex-column overflow-hidden">
            <!-- Chat Header -->
            <div class="card-header d-flex align-items-center p-3 border-0">
                <div class="rounded-circle bg-dark p-2 me-3 border border-primary">
                    <i class="bi bi-robot text-primary fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-0 text-light fw-bold">Asistente CineNova</h5>
                    <small class="text-muted">En línea | Consultas en tiempo real</small>
                </div>
            </div>

            <!-- Chat Messages Container -->
            <div id="chatWindow" class="card-body overflow-auto p-4 flex-grow-1 bg-dark" style="scroll-behavior: smooth;">
                <!-- Welcome Message -->
                <div class="chat-bubble agent-bubble mb-3 animate-fade-in">
                    <div class="bubble-content p-3 shadow border-start border-4 border-primary">
                        <p class="mb-0 text-light">¡Hola! Soy tu asistente de CineNova. Puedo ayudarte a consultar tus registros, ver estadísticas de latencia o encontrar películas similares. ¿En qué puedo ayudarte hoy?</p>
                    </div>
                </div>
            </div>

            <!-- Suggested Questions -->
            <div class="bg-dark border-top border-secondary no-scrollbar flex-shrink-0"
                 style="overflow-x: auto; overflow-y: hidden; height: 52px; display: flex; align-items: center; padding: 0 12px;">
                <div class="d-flex gap-2" style="width: max-content;">
                    <button class="btn btn-outline-light btn-sm rounded-pill suggestion-btn" style="white-space: nowrap;">¿Qué películas tengo?</button>
                    <button class="btn btn-outline-light btn-sm rounded-pill suggestion-btn" style="white-space: nowrap;">¿Cuál fue la última que agregué?</button>
                    <button class="btn btn-outline-light btn-sm rounded-pill suggestion-btn" style="white-space: nowrap;">Dame un resumen de mis películas</button>
                </div>
            </div>

            <!-- Chat Input -->
            <div class="card-footer bg-dark p-3 border-top border-secondary">
                <form id="chatForm" class="input-group">
                    <input type="text" id="userInput" class="form-control rounded-pill-start border-secondary bg-grey px-4 text-light" placeholder="Escribe tu pregunta aquí..." autocomplete="off">
                    <button class="btn btn-primary rounded-pill-end px-4" type="submit">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-grey {
        background-color: var(--gx-grey) !important;
    }

    .chat-bubble {
        max-width: 85%;
    }

    .user-bubble {
        align-self: flex-end;
        margin-left: auto;
    }

    .agent-bubble {
        align-self: flex-start;
    }

    .user-bubble .bubble-content {
        background-color: var(--gx-red);
        color: white;
        border-radius: 1.2rem 1.2rem 0 1.2rem;
        box-shadow: 0 4px 15px rgba(250, 30, 78, 0.3);
    }

    .agent-bubble .bubble-content {
        background-color: var(--gx-grey);
        border-radius: 1.2rem 1.2rem 1.2rem 0;
        border: 1px solid var(--gx-border);
    }

        /* Formato del texto del agente */
        .agent-bubble .bubble-content p {
            white-space: pre-wrap;
            word-break: break-word;
            margin-bottom: 0;
            line-height: 1.6;
        }

        /* Filas con ícono (líneas que empiezan con - ) */
        .agent-bubble .bubble-content .msg-line {
            display: block;
            padding: 1px 0;
        }

    .animate-fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .typing-indicator span {
        height: 8px;
        width: 8px;
        background: var(--gx-red);
        display: inline-block;
        border-radius: 50%;
        animation: bounce 1.3s infinite;
        opacity: 0.4;
    }

        .typing-indicator span:nth-child(2) {
            animation-delay: 0.15s;
        }

        .typing-indicator span:nth-child(3) {
            animation-delay: 0.3s;
        }

    @@keyframes bounce {
        0%, 60%, 100% {
            transform: translateY(0);
        }

        30% {
            transform: translateY(-4px);
        }
    }
</style>

@section Scripts {
    <script>
        const chatWindow = document.getElementById('chatWindow');
        const chatForm = document.getElementById('chatForm');
        const userInput = document.getElementById('userInput');

        /**
         * Convierte el texto plano del agente a HTML legible:
         * - Escapa HTML para seguridad
         * - Convierte líneas "- Campo: valor" en filas con estilo
         * - Convierte \n en saltos de línea reales
         * - Resalta emojis ✅ ⚠️ al inicio de línea
         */
        function formatAgentText(text) {
            // 1) Escapar HTML
            const escaped = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // 2) Procesar línea por línea
            const lines = escaped.split('\n');
            const html = lines.map(line => {
                const trimmed = line.trim();
                if (trimmed === '') return '<br>';

                // Líneas de campo: "- Título: valor"
                if (/^-\s+\w/.test(trimmed)) {
                    const content = trimmed.substring(1).trim();
                    const colonIdx = content.indexOf(':');
                    if (colonIdx > -1) {
                        const key = content.substring(0, colonIdx).trim();
                        const val = content.substring(colonIdx + 1).trim();
                        return `<span class="msg-line" style="padding-left:4px;">
                                        <span style="color:var(--gx-red);font-weight:600;">${key}:</span>
                                        <span style="color:#e0e0e0;"> ${val}</span>
                                    </span>`;
                    }
                    return `<span class="msg-line" style="padding-left:4px; color:#e0e0e0;">${trimmed}</span>`;
                }

                // Líneas con ✅ o ⚠️ al inicio → destacar
                if (/^[✅⚠️]/.test(trimmed)) {
                    return `<span class="msg-line" style="font-weight:600; color:#e0e0e0;">${trimmed}</span>`;
                }

                return `<span class="msg-line" style="color:#e0e0e0;">${trimmed}</span>`;
            });

            return html.join('');
        }

        function appendMessage(text, isUser = false, data = null) {
            const container = document.createElement('div');
            container.className = `chat-bubble ${isUser ? 'user-bubble' : 'agent-bubble'} mb-3 animate-fade-in`;

            let innerHtml;
            if (isUser) {
                // Mensaje del usuario: texto plano escapado
                const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                innerHtml = `
                        <div class="bubble-content p-3 shadow">
                            <p class="mb-0 text-white" style="white-space:pre-wrap;word-break:break-word;">${escaped}</p>
                        </div>`;
            } else {
                // Mensaje del agente: formateado
                innerHtml = `
                        <div class="bubble-content p-3 shadow border-start border-4 border-primary">
                            <div class="text-light" style="line-height:1.7;">${formatAgentText(text)}</div>
                            ${data ? renderData(data) : ''}
                        </div>`;
            }

            container.innerHTML = innerHtml;
            chatWindow.appendChild(container);
            scrollToBottom();
        }

        function renderData(data) {
            if (!Array.isArray(data) || data.length === 0) return '';

            let table = `<div class="table-responsive mt-3">
                    <table class="table table-sm table-bordered border-secondary small mb-0 text-light">
                        <thead><tr class="text-primary">`;

            const keys = Object.keys(data[0]);
            keys.forEach(key => table += `<th class="text-uppercase">${key}</th>`);
            table += `</tr></thead><tbody>`;

            data.forEach(row => {
                table += `<tr>`;
                keys.forEach(key => table += `<td>${row[key] ?? '-'}</td>`);
                table += `</tr>`;
            });

            table += `</tbody></table></div>`;
            return table;
        }

        function scrollToBottom() {
            setTimeout(() => { chatWindow.scrollTop = chatWindow.scrollHeight; }, 50);
        }

        function showTypingIndicator() {
            const div = document.createElement('div');
            div.id = 'typingIndicator';
            div.className = 'chat-bubble agent-bubble mb-3 animate-fade-in';
            div.innerHTML = `
                    <div class="bubble-content p-3 shadow border-start border-4 border-primary">
                        <div class="typing-indicator"><span></span> <span></span> <span></span></div>
                    </div>`;
            chatWindow.appendChild(div);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            if (indicator) indicator.remove();
        }

        chatForm.onsubmit = async (e) => {
            e.preventDefault();
            const question = userInput.value.trim();
            if (!question) return;

            userInput.value = '';
            appendMessage(question, true);
            showTypingIndicator();

            try {
                const response = await fetch('/api/agent/query', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question })
                });

                const result = await response.json();
                removeTypingIndicator();
                appendMessage(result.answer, false, result.data);
            } catch (error) {
                removeTypingIndicator();
                appendMessage("Lo siento, hubo un error al procesar tu consulta.", false);
            }
        };

        // Sugerencias rápidas
        document.querySelectorAll('.suggestion-btn').forEach(btn => {
            btn.onclick = () => {
                userInput.value = btn.innerText;
                chatForm.dispatchEvent(new Event('submit'));
            };
        });
    </script>
}
