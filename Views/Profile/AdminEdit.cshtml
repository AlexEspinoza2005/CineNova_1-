@model MovieApi.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Administrar Usuario";
    var profileId = ViewBag.ProfileId;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-9">
        <div class="premium-form-container p-5 rounded-4 shadow-lg">
            <div class="text-center mb-5">
                <h1 class="display-6 fw-bold text-white uppercase letter-spacing-5">ADMINISTRAR <span class="text-primary">USUARIO</span></h1>
                <div class="hero-divider"></div>
            </div>

            <form asp-controller="Profile" asp-action="AdminEdit" asp-route-id="@profileId" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label-premium">NOMBRE COMPLETO</label>
                        <input asp-for="FullName" class="form-control-premium w-100" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label-premium">NOMBRE DE USUARIO</label>
                        <input asp-for="Username" class="form-control-premium w-100" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Bio" class="form-label-premium">BIOGRAFÍA DE SISTEMA</label>
                    <textarea asp-for="Bio" class="form-control-premium w-100" rows="3" placeholder="Biografía del usuario..."></textarea>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label-premium">CIUDAD</label>
                        <input asp-for="City" class="form-control-premium w-100" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Country" class="form-label-premium">PAÍS</label>
                        <input asp-for="Country" class="form-control-premium w-100" />
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <label asp-for="ImageFile" class="form-label-premium">ACTUALIZAR AVATAR <span class="opacity-25">(SUBIR ARCHIVO)</span></label>
                        <input asp-for="ImageFile" type="file" class="form-control-premium w-100" accept="image/*" />
                    </div>
                    <div class="col-md-12">
                        <label asp-for="AvatarUrl" class="form-label-premium">URL DE AVATAR <span class="opacity-25">(OPCIONAL/LINK)</span></label>
                        <input asp-for="AvatarUrl" class="form-control-premium w-100" />
                    </div>
                </div>

                <div class="mb-5">
                    <label asp-for="FavoriteGenresString" class="form-label-premium">GÉNEROS PREFERIDOS</label>
                    <input asp-for="FavoriteGenresString" class="form-control-premium w-100" placeholder="Acción, Drama..." />
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top border-secondary">
                    <a asp-controller="DashboardView" asp-action="Index" class="btn btn-outline-light px-4">CANCELAR</a>
                    <button type="submit" class="btn btn-primary px-5 py-3">GUARDAR CAMBIOS</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
