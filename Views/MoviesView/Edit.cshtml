@model MovieApi.Models.ViewModels.MovieViewModel
@{
    ViewData["Title"] = "Editar Película";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="premium-form-container p-5 rounded-4 shadow-lg">
            <div class="text-center mb-5">
                <h1 class="display-6 fw-bold text-white uppercase letter-spacing-5">EDITAR <span class="text-primary">PELÍCULA</span></h1>
                <div class="hero-divider"></div>
            </div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label-premium">TÍTULO DE LA OBRA</label>
                        <input asp-for="Title" class="form-control-premium" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Year" class="form-label-premium">AÑO</label>
                        <input asp-for="Year" class="form-control-premium" />
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Genre" class="form-label-premium">GÉNERO</label>
                        <input asp-for="Genre" class="form-control-premium" />
                        <span asp-validation-for="Genre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Director" class="form-label-premium">DIRECTOR</label>
                        <input asp-for="Director" class="form-control-premium" />
                        <span asp-validation-for="Director" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Synopsis" class="form-label-premium">SINOPSIS ARGUMENTAL</label>
                    <textarea asp-for="Synopsis" class="form-control-premium w-100" rows="5" style="border-radius: 4px !important;"></textarea>
                    <span asp-validation-for="Synopsis" class="text-danger small"></span>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <label asp-for="DurationMin" class="form-label-premium">DURACIÓN <span class="opacity-25">(MIN)</span></label>
                        <input asp-for="DurationMin" class="form-control-premium" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="ImageFile" class="form-label-premium">ACTUALIZAR PÓSTER <span class="opacity-25">(OPCIONAL)</span></label>
                        <input asp-for="ImageFile" type="file" class="form-control-premium" accept="image/*" />
                        <div class="small text-muted mt-1 opacity-50">O cambia la URL actual:</div>
                        <input asp-for="CoverUrl" class="form-control-premium mt-1" />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top border-secondary">
                    <a asp-action="Index" class="btn btn-outline-light px-4">CANCELAR</a>
                    <button type="submit" class="btn btn-primary px-5 py-3">ACTUALIZAR CAMBIOS</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .premium-form-container {
        background: linear-gradient(145deg, #16161a 0%, #0b0b0d 100%);
        border: 1px solid var(--gx-border);
        position: relative;
    }
    .form-label-premium {
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 2px;
        color: var(--gx-text-muted);
        text-transform: uppercase;
        margin-bottom: 0.75rem;
        display: block;
    }
    .form-control-premium {
        background: var(--gx-dark) !important;
        border: 1px solid var(--gx-border) !important;
        border-radius: 12px !important;
        padding: 1rem !important;
        color: white !important;
        transition: 0.3s;
    }
    .form-control-premium:focus {
        border-color: var(--gx-red) !important;
        box-shadow: 0 0 15px rgba(250, 30, 78, 0.15) !important;
        outline: none;
    }
    .letter-spacing-5 { letter-spacing: 5px; }
    .hero-divider {
        width: 60px;
        height: 3px;
        background: var(--gx-red);
        margin: 15px auto;
        box-shadow: 0 0 10px var(--gx-red);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
