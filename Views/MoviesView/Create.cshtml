@model MovieApi.Models.ViewModels.MovieViewModel
@{
    ViewData["Title"] = "Registrar Película";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-9">
        <div class="premium-form-container p-5 rounded-4 shadow-lg">
            <div class="text-center mb-5">
                <h1 class="display-6 fw-bold text-white uppercase letter-spacing-5">REGISTRAR <span class="text-primary">PELÍCULA</span></h1>
                <div class="hero-divider"></div>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label-premium">TÍTULO DE LA OBRA</label>
                        <input asp-for="Title" class="form-control-premium w-100" placeholder="Ej: Inception" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Year" class="form-label-premium">AÑO</label>
                        <input asp-for="Year" class="form-control-premium w-100" placeholder="2010" />
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Genre" class="form-label-premium">GÉNERO</label>
                        <input asp-for="Genre" class="form-control-premium w-100" placeholder="Sci-Fi, Acción" />
                        <span asp-validation-for="Genre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Director" class="form-label-premium">DIRECTOR</label>
                        <input asp-for="Director" class="form-control-premium w-100" placeholder="Christopher Nolan" />
                        <span asp-validation-for="Director" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Synopsis" class="form-label-premium">SINOPSIS ARGUMENTAL</label>
                    <textarea asp-for="Synopsis" class="form-control-premium w-100" rows="5" style="border-radius: 4px !important;" placeholder="Describe brevemente la trama..."></textarea>
                    <span asp-validation-for="Synopsis" class="text-danger small"></span>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <label asp-for="DurationMin" class="form-label-premium">DURACIÓN <span class="opacity-25">(MIN)</span></label>
                        <input asp-for="DurationMin" class="form-control-premium w-100" placeholder="120" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="ImageFile" class="form-label-premium">SUBIR PÓSTER <span class="opacity-25">(RECOMENDADO)</span></label>
                        <input asp-for="ImageFile" type="file" class="form-control-premium w-100" accept="image/*" />
                        <div class="small text-muted mt-2 opacity-50 uppercase">O PEGA UNA URL:</div>
                        <input asp-for="CoverUrl" class="form-control-premium w-100 mt-1" placeholder="https://..." />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top border-secondary">
                    <a asp-action="Index" class="btn btn-outline-light px-4">CANCELAR</a>
                    <button type="submit" class="btn btn-primary px-5 py-3">GUARDAR CAMBIOS</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
