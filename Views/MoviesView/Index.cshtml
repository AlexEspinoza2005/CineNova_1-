@model MovieApi.Models.ViewModels.MovieListViewModel
@{
    ViewData["Title"] = "Catálogo de Películas";
}

<style>
    .movie-premium-card {
        background: var(--gx-panel);
        border: 1px solid var(--gx-border);
        border-radius: 12px;
        overflow: hidden;
        transition: 0.4s;
    }
    .movie-premium-card:hover {
        border-color: var(--gx-red);
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.6);
    }
    
    .movie-poster-container {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }
    .movie-poster {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.6s;
    }
    .movie-poster-placeholder {
        width: 100%;
        height: 100%;
        background: var(--gx-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: #333;
    }
    
    .movie-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 60%);
        opacity: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }
    .movie-premium-card:hover .movie-overlay { opacity: 1; }
    .movie-premium-card:hover .movie-poster { transform: scale(1.1); filter: blur(2px); }
    
    .btn-action-circle {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        margin: 0 5px;
        transition: 0.3s;
        font-size: 0.9rem;
    }
    .btn-action-circle:hover {
        background: var(--gx-red);
        border-color: var(--gx-red);
        color: white;
        transform: scale(1.1);
    }
    
    .movie-title {
        font-weight: 700;
        font-size: 0.85rem !important;
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: white;
    }
    .movie-genre-small { font-size: 0.65rem; color: var(--gx-red); text-transform: uppercase; font-weight: 700; }
    .movie-year-small { font-size: 0.65rem; color: var(--gx-text-muted); }
</style>

<div class="d-flex justify-content-between align-items-center mb-5 mt-3">
    <h1 class="display-6 fw-bold text-light m-0"><span class="text-primary">CATÁLOGO</span> CINENOVA</h1>
    <a asp-action="Create" class="btn btn-primary px-4">
        <i class="bi bi-plus-lg me-2"></i> REGISTRAR PELÍCULA
    </a>
</div>

<div class="row g-3">
    @foreach (var movie in Model.Movies)
    {
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
            <div class="movie-premium-card h-100">
                <div class="movie-poster-container">
                    @if (!string.IsNullOrEmpty(movie.CoverUrl))
                    {
                        <img src="@movie.CoverUrl" class="movie-poster" alt="@movie.Title">
                    }
                    else
                    {
                        <div class="movie-poster-placeholder">
                            <i class="bi bi-film"></i>
                        </div>
                    }
                    <div class="movie-overlay">
                        <div class="movie-actions">
                            <a asp-action="Details" asp-route-id="@movie.Id" class="btn-action-circle" title="Detalles">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            @if (User.IsInRole("admin") || movie.UserId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                            {
                                <a asp-action="Edit" asp-route-id="@movie.Id" class="btn-action-circle" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
                <div class="movie-info p-2">
                    <h6 class="movie-title">@movie.Title</h6>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="movie-genre-small">@movie.Genre</span>
                        <span class="movie-year-small">@movie.Year</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
