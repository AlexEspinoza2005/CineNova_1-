@model MovieApi.Models.MovieList
@{
    ViewData["Title"] = Model.Name;
    var items = ViewBag.Items as List<MovieApi.Models.MovieListItem>;
}

<style>
    .movie-premium-card {
        background: var(--gx-panel);
        border: 1px solid var(--gx-border);
        border-radius: 12px;
        overflow: hidden;
        transition: 0.4s;
    }
    .movie-premium-card:hover {
        border-color: var(--gx-red);
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.6);
    }
    .movie-poster-container { position: relative; aspect-ratio: 2/3; overflow: hidden; }
    .movie-poster { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
    .movie-poster-placeholder { width: 100%; height: 100%; background: var(--gx-dark); display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #333; }
    .movie-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 60%); opacity: 0; display: flex; align-items: center; justify-content: center; transition: 0.3s; }
    .movie-premium-card:hover .movie-overlay { opacity: 1; }
    .movie-premium-card:hover .movie-poster { transform: scale(1.1); filter: blur(2px); }
    .btn-action-circle { width: 38px; height: 38px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); backdrop-filter: blur(10px); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: white; margin: 0 5px; transition: 0.3s; }
    .btn-action-circle:hover { background: var(--gx-red); border-color: var(--gx-red); color: white; transform: scale(1.1); }
    .movie-title { font-weight: 700; font-size: 0.85rem; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: white; }
    .movie-genre-small { font-size: 0.65rem; color: var(--gx-red); text-transform: uppercase; font-weight: 700; }
    .premium-search-box { background: var(--gx-panel); border: 1px solid var(--gx-border); border-radius: 12px; width: 350px; }
    .form-control-premium { background: var(--gx-dark) !important; border: 1px solid var(--gx-border) !important; color: white !important; border-radius: 8px !important; }
</style>

<div class="mb-5 mt-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item small"><a asp-action="Index">MIS LISTAS</a></li>
                <li class="breadcrumb-item active small text-primary" aria-current="page">@Model.Name.ToUpper()</li>
              </ol>
            </nav>
            <h1 class="display-5 fw-bold text-white">@Model.Name</h1>
            <p class="text-muted lead">@Model.Description</p>
        </div>
        @if (ViewBag.IsOwner)
        {
            <div class="premium-search-box p-3 shadow">
                <h6 class="fw-bold mb-3 small letter-spacing-1 text-primary">AÑADIR PELÍCULA</h6>
                <div class="position-relative">
                    <input type="text" id="movieSearch" class="form-control-premium w-100" placeholder="Buscar título...">
                    <div id="searchResults" class="list-group position-absolute w-100 mt-1 shadow-lg d-none" style="z-index: 1000; background: var(--gx-panel); border: 1px solid var(--gx-border);">
                        <!-- Results -->
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="row g-3">
    @if (items != null && items.Any())
    {
        foreach (var item in items)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="movie-premium-card h-100 position-relative">
                    <div class="movie-poster-container">
                        @if (!string.IsNullOrEmpty(item.Movie?.CoverUrl))
                        {
                            <img src="@item.Movie.CoverUrl" class="movie-poster" alt="@item.Movie.Title">
                        }
                        else
                        {
                            <div class="movie-poster-placeholder">
                                <i class="bi bi-film"></i>
                            </div>
                        }
                        <div class="movie-overlay">
                            <div class="movie-actions">
                                <a asp-controller="MoviesView" asp-action="Details" asp-route-id="@item.MovieId" class="btn-action-circle" title="Detalles">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                @if (ViewBag.IsOwner)
                                {
                                    <form asp-action="RemoveMovie" asp-route-id="@Model.Id" asp-route-movieId="@item.MovieId" method="post" class="d-inline">
                                        <button type="submit" class="btn-action-circle text-danger" title="Quitar">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="movie-info p-2">
                        <h6 class="movie-title">@item.Movie?.Title</h6>
                        <span class="movie-genre-small">@item.Movie?.Genre</span>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5 opacity-25">
            <i class="bi bi-folder2-open display-1"></i>
            <p class="mt-3 fs-5">Esta lista está vacía.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('movieSearch');
        const resultsDiv = document.getElementById('searchResults');
        const listId = '@Model.Id';

        if (searchInput) {
            searchInput.addEventListener('input', async (e) => {
                const query = e.target.value;
                if (query.length < 2) {
                    resultsDiv.classList.add('d-none');
                    return;
                }

                try {
                    const response = await fetch(`/Lists/SearchMovies/${listId}?query=${query}`);
                    const movies = await response.json();

                    resultsDiv.innerHTML = '';
                    if (movies.length > 0) {
                        movies.forEach(movie => {
                            const btn = document.createElement('button');
                            btn.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 small bg-dark text-light border-secondary';
                            btn.innerHTML = `
                                <img src="${movie.coverUrl || ''}" width="30" height="40" class="rounded object-fit-cover" onerror="this.src='/images/no-cover.png'">
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-truncate" style="max-width: 200px;">${movie.title}</div>
                                    <div class="text-muted small">${movie.year}</div>
                                </div>
                                <i class="bi bi-plus-lg text-primary"></i>
                            `;
                            btn.onclick = () => addMovieToList(movie.id);
                            resultsDiv.appendChild(btn);
                        });
                        resultsDiv.classList.remove('d-none');
                    } else {
                        resultsDiv.innerHTML = '<div class="list-group-item small text-muted bg-dark border-secondary">No se encontraron películas</div>';
                        resultsDiv.classList.remove('d-none');
                    }
                } catch (err) {
                    console.error('Search error:', err);
                }
            });

            // Hide results when clicking outside
            document.addEventListener('click', (e) => {
                if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
                    resultsDiv.classList.add('d-none');
                }
            });
        }

        async function addMovieToList(movieId) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/Lists/AddMovie/${listId}?movieId=${movieId}`;
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}
